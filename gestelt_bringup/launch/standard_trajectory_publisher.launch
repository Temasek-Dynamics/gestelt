<launch>
    <arg name="simulation" default="true" />
    <arg name="test_time" default="40" />

    <arg if="$(arg simulation)" name="circle_center_x" default="0.0" />
    <arg if="$(arg simulation)" name="circle_center_y" default="1.5" /> <!-- oppsite with the drone position -->

    <arg unless="$(arg simulation)" name="circle_center_x" default="0.0" />
    <arg unless="$(arg simulation)" name="circle_center_y" default="0.0" />

    <node pkg="standard_trajectory_publisher" type="standard_trajectory_publisher" name="standard_trajectory_publisher" output="screen">
        <param name="trajectory_type" value="1" />
        <!-- <param name="shape_omega" value="" />  -->
        <param name="acc_dec_time" value="10" />
        <param name="stop_time" value="$(arg test_time)" />
        <param name="max_angular_vel" value="0.5" /> <!--!!! max 3.0!!! -->
        <param name="initpos_x" value="$(arg circle_center_x)" />
        <param name="initpos_y" value="$(arg circle_center_y)" />
        <param name="initpos_z" value="1.2" />
        <param name="reference_type" value="2" />
  </node> 
</launch>