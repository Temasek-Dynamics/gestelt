<launch>
  <arg name="platform" default="laptop"/> <!-- for the python.prof check-->
  <arg name="record" default="true"/>
  <arg name="data_dir" default="/home/tlab-uav/gestelt_ws/src/gestelt/gestelt_bringup/data"/> <!-- Set data directory path  $(find gestelt_bringup)/data-->
  

  <rosparam file="$(find gestelt_bringup)/config/learning_agile_mission.yaml" command="load"/>
  <node pkg="gestelt_bringup" name="mission" type="learning_agile_ROS_mission.py">
        <param name="is_simulation" value="True"/>
        
  </node>


  <!--for running on the Radxa, This record does not start, 
  instead rosbag record will run on the laptop, in a seperate launch-->
  <arg name="record_topics" default="
    (.*)mavros(.*)
  (.*)traj_server(.*)
  (.*)learning_agile_sim(.*)
  "
  />

  <!-- record topic if record = true -->
  <node if="$(arg record)" pkg="rosbag" type="record" name="record" output="screen"
        args="-o $(arg data_dir)/ -e $(arg record_topics)"/>

</launch>